# Audio, Graphics and Plugins folders
Audio/
Graphics/
Plugins/
Screenshots/

# Data folder, except messages_core.dat
# Data/Scripts.rxdata is a locally-generated script cache — not tracked (see CLAUDE.md)
Data/*
!Data/messages_core.dat

# Files in the main project folder
errorlog.txt
Game.ini
Game.rxproj
RGSS*.dll

# Common code editor folders & files
.vscode/
*.code-workspace
.idea/
*.mkproj

# Ruby LSP local cache (regenerated per machine)
.ruby-lsp/

# Local (personal) Claude Code / hookify files — not shared via the repo
.claude/*.local.md
.claude/settings.local.json

# Operating system generated files & folders
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temp / backup files
~*
*.tmp
*.bak
*.orig
*.log
